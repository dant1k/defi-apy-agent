# Database
DATABASE_URL=postgresql://genora:genora_pass@postgres:5432/genora_terminal
POSTGRES_USER=genora
POSTGRES_PASSWORD=genora_pass
POSTGRES_DB=genora_terminal

# Redis
REDIS_URL=redis://redis:6379/0

# External APIs
DEFILLAMA_API_URL=https://api.llama.fi
DEXSCREENER_API_URL=https://api.dexscreener.com

# Scheduler
SCHEDULER_ENABLED=true
REFRESH_DEXES_INTERVAL_MINUTES=15
REFRESH_POOLS_INTERVAL_MINUTES=10
TOP_DEXES_COUNT=10

# Cache TTL (seconds)
CACHE_DEXES_TTL=300
CACHE_DEX_DETAIL_TTL=300
CACHE_POOLS_TTL=120

# Logging
LOG_LEVEL=INFO
